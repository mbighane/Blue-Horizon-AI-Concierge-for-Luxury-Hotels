{
    "version": "0.2.0",
    "configurations": [

        
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "presentation": {
                "group": "General",
                "order": 50
            }
        },
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}",
            "presentation": {
                "group": "General",
                "order": 51
            }
        },
        {
            "name": "Debug: run_concierge.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/run_concierge.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug: test_cli.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/test_cli.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug: demo_cli.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/demo_cli.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug: CLI Script",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/cli.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug: test_vector_search.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/test_vector_search.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "presentation": {
                "group": "Recommended",
                "order": 1
            }
        },
        {
            "name": "Debug: pytest test_call_nl2sql",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests/unit/test_call_nl2sql.py",
                "-v",
                "--tb=short"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "presentation": {
                "group": "Recommended",
                "order": 2
            }
        },
        {
            "name": "Debug: Streamlit App",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "module": "streamlit",
            "args": [
                "run",
                "frontend/pages/streamlit_app.py",
                "--server.headless=true",
                "--server.port=8501"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "subProcess": true,
            "presentation": {
                "group": "Recommended",
                "order": 3
            }
        },
        {
            "name": "Debug: FastAPI Backend",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "module": "uvicorn",
            "args": [
                "backend.app.main:app",
                "--reload",
                "--port=8000"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "presentation": {
                "group": "Recommended",
                "order": 4
            }
        },
        {
            "name": "Debug: setup_vector_search.py",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "program": "${workspaceFolder}/scripts/setup_vector_search.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "presentation": {
                "group": "Recommended",
                "order": 5
            }
        }
    ]
}